// Spawn a glb model with its textures, materials, skins, and animations
ns_spawn_model :: extern fn(app: App, glb: ^u8, glb_len: i64, position_x: f32, position_y: f32, position_z: f32) -> Entity
spawn_model :: fn(app: App, glb: []u8, position_x: f32, position_y: f32, position_z: f32) -> Entity {
    mut glb_ptr := null_of($u8)
    if (slice_len(glb) > 0) {
        glb_ptr = ptr_to(glb[0])
    }
    held := unsafe { ns_spawn_model(app, glb_ptr, slice_len(glb), position_x, position_y, position_z) }
    held
}

// Spawn an entity rendering a mesh built from raw vertex data
ns_spawn_custom_mesh :: extern fn(app: App, name: ^i8, positions: ^f32, positions_len: i64, normals: ^f32, normals_len: i64, uvs: ^f32, uvs_len: i64, indices: ^u32, indices_len: i64, position_x: f32, position_y: f32, position_z: f32) -> Entity
spawn_custom_mesh :: fn(app: App, name: str, positions: []f32, normals: []f32, uvs: []f32, indices: []u32, position_x: f32, position_y: f32, position_z: f32) -> Entity {
    name_held := c_string(name)
    mut positions_ptr := null_of($f32)
    if (slice_len(positions) > 0) {
        positions_ptr = ptr_to(positions[0])
    }
    mut normals_ptr := null_of($f32)
    if (slice_len(normals) > 0) {
        normals_ptr = ptr_to(normals[0])
    }
    mut uvs_ptr := null_of($f32)
    if (slice_len(uvs) > 0) {
        uvs_ptr = ptr_to(uvs[0])
    }
    mut indices_ptr := null_of($u32)
    if (slice_len(indices) > 0) {
        indices_ptr = ptr_to(indices[0])
    }
    held := unsafe { ns_spawn_custom_mesh(app, ptr_cast($i8, name_held), positions_ptr, slice_len(positions), normals_ptr, slice_len(normals), uvs_ptr, slice_len(uvs), indices_ptr, slice_len(indices), position_x, position_y, position_z) }
    heap_release($u8, name_held)
    held
}

// Capture an entity subtree as a named reusable prefab
ns_register_prefab :: extern fn(app: App, name: ^i8, value root: Entity) -> bool
register_prefab :: fn(app: App, name: str, root: Entity) -> bool {
    name_held := c_string(name)
    held := unsafe { ns_register_prefab(app, ptr_cast($i8, name_held), root) }
    heap_release($u8, name_held)
    held
}

// Stamp a copy of a named prefab at a position
ns_spawn_prefab_named :: extern fn(app: App, name: ^i8, position_x: f32, position_y: f32, position_z: f32, out_len: ^i64) -> ^Entity
spawn_prefab_named :: fn(app: App, name: str, position_x: f32, position_y: f32, position_z: f32) -> Entities {
    name_held := c_string(name)
    mut out_len : i64 = 0
    held := unsafe { ns_spawn_prefab_named(app, ptr_cast($i8, name_held), position_x, position_y, position_z, ptr_to(out_len)) }
    heap_release($u8, name_held)
    entities_from(held, out_len)
}

