// Register a texture from encoded png or jpeg bytes
ns_load_texture :: extern fn(app: App, name: ^i8, image_bytes: ^u8, image_bytes_len: i64)
load_texture :: fn(app: App, name: str, image_bytes: []u8) {
    name_held := c_string(name)
    mut image_bytes_ptr := null_of($u8)
    if (slice_len(image_bytes) > 0) {
        image_bytes_ptr = ptr_to(image_bytes[0])
    }
    unsafe { ns_load_texture(app, ptr_cast($i8, name_held), image_bytes_ptr, slice_len(image_bytes)) }
    heap_release($u8, name_held)
}

// Register a linear-space texture for normal, metallic-roughness, or occlusion data
ns_load_texture_linear :: extern fn(app: App, name: ^i8, image_bytes: ^u8, image_bytes_len: i64)
load_texture_linear :: fn(app: App, name: str, image_bytes: []u8) {
    name_held := c_string(name)
    mut image_bytes_ptr := null_of($u8)
    if (slice_len(image_bytes) > 0) {
        image_bytes_ptr = ptr_to(image_bytes[0])
    }
    unsafe { ns_load_texture_linear(app, ptr_cast($i8, name_held), image_bytes_ptr, slice_len(image_bytes)) }
    heap_release($u8, name_held)
}

// Register a texture from raw RGBA8 pixels
ns_register_texture :: extern fn(app: App, name: ^i8, width: u32, height: u32, rgba: ^u8, rgba_len: i64)
register_texture :: fn(app: App, name: str, width: u32, height: u32, rgba: []u8) {
    name_held := c_string(name)
    mut rgba_ptr := null_of($u8)
    if (slice_len(rgba) > 0) {
        rgba_ptr = ptr_to(rgba[0])
    }
    unsafe { ns_register_texture(app, ptr_cast($i8, name_held), width, height, rgba_ptr, slice_len(rgba)) }
    heap_release($u8, name_held)
}

