cursor_on_ground :: fn(app: App) -> (found: bool, vector: Vec3) {
    mut out := Vec3 { x = 0.0, y = 0.0, z = 0.0 }
    held := unsafe { ns_cursor_on_ground(app, ptr_to(out)) }
    return held, out
}

// Spawn a flat panel in the 3d world facing the camera
