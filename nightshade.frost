// Register a named material in the shared registry
ns_register_material :: extern fn(app: App, name: ^i8, base_color_x: f32, base_color_y: f32, base_color_z: f32, base_color_w: f32, metallic: f32, roughness: f32, emissive_x: f32, emissive_y: f32, emissive_z: f32) -> ^i8
register_material :: fn(app: App, name: str, base_color_x: f32, base_color_y: f32, base_color_z: f32, base_color_w: f32, metallic: f32, roughness: f32, emissive_x: f32, emissive_y: f32, emissive_z: f32) -> Text {
    name_held := c_string(name)
    held := unsafe { ns_register_material(app, ptr_cast($i8, name_held), base_color_x, base_color_y, base_color_z, base_color_w, metallic, roughness, emissive_x, emissive_y, emissive_z) }
    heap_release($u8, name_held)
    text_from(held)
}

// Replace the material registered under a name and reupload it
ns_update_material :: extern fn(app: App, name: ^i8, base_color_x: f32, base_color_y: f32, base_color_z: f32, base_color_w: f32, metallic: f32, roughness: f32, emissive_x: f32, emissive_y: f32, emissive_z: f32)
update_material :: fn(app: App, name: str, base_color_x: f32, base_color_y: f32, base_color_z: f32, base_color_w: f32, metallic: f32, roughness: f32, emissive_x: f32, emissive_y: f32, emissive_z: f32) {
