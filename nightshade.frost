// Spawn one object at each position, all sharing one material
ns_spawn_objects :: extern fn(app: App, shape: u32, scale_x: f32, scale_y: f32, scale_z: f32, color_x: f32, color_y: f32, color_z: f32, color_w: f32, value body: Body, positions: ^Vec3, positions_len: i64, out_len: ^i64) -> ^Entity
spawn_objects :: fn(app: App, shape: u32, scale_x: f32, scale_y: f32, scale_z: f32, color_x: f32, color_y: f32, color_z: f32, color_w: f32, body: Body, positions: []Vec3) -> Entities {
    mut positions_ptr := null_of($Vec3)
    if (slice_len(positions) > 0) {
        positions_ptr = ptr_to(positions[0])
    }
    mut out_len : i64 = 0
    held := unsafe { ns_spawn_objects(app, shape, scale_x, scale_y, scale_z, color_x, color_y, color_z, color_w, body, positions_ptr, slice_len(positions), ptr_to(out_len)) }
    entities_from(held, out_len)
}

