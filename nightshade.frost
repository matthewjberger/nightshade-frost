has_tag :: fn(app: App, entity: Entity, label: str) -> bool {
    label_held := c_string(label)
    held := unsafe { ns_has_tag(app, entity, ptr_cast($i8, label_held)) }
    heap_release($u8, label_held)
    held
}

// Get every entity carrying the label
ns_query_tagged :: extern fn(app: App, label: ^i8, out_len: ^i64) -> ^Entity
query_tagged :: fn(app: App, label: str) -> Entities {
    label_held := c_string(label)
    mut out_len : i64 = 0
    held := unsafe { ns_query_tagged(app, ptr_cast($i8, label_held), ptr_to(out_len)) }
    heap_release($u8, label_held)
    entities_from(held, out_len)
}

