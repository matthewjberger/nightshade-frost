import "mem.frost"

// An open engine window. It owns the renderer and the event loop, so every call
// for one handle belongs to the thread that opened it.
App :: distinct ^u8

// An entity, which is a slot and the generation of what was in it. A handle to
// a freed slot reads as stale rather than as whatever took its place.
Entity :: struct { id: u32, generation: u32 }

Vec3 :: struct { x: f32, y: f32, z: f32 }

// What the engine hands back, under types that say who frees it. Each is
// `linear`, so the compiler refuses a program that drops one, and the free that
// consumes it is the one matching what it holds.
Text :: linear struct { text: str, pointer: ^i8 }
Entities :: linear struct { items: []Entity, pointer: ^Entity, count: i64 }
Strings :: linear struct { pointer: ^^i8, count: i64 }
Bytes :: linear struct { items: []u8, pointer: ^u8, count: i64 }

// A run of NUL-terminated copies, for a call that takes several strings at
// once. It owns both the copies and the array of pointers into them.
CStrings :: struct { pointer: ^^i8, blocks: []^u8, count: i64 }

frost_rt_error :: extern fn(text: ^i8)
frost_rt_die :: safe extern fn()
frost_rt_bounds_check :: safe extern fn(index: i64, length: i64)

ns_open :: extern fn() -> App
ns_frame :: extern fn(app: App) -> bool
ns_close :: extern fn(app: App)
ns_free_string :: extern fn(text: ^i8)
ns_free_entities :: extern fn(pointer: ^Entity, len: i64)
ns_free_strings :: extern fn(pointer: ^^i8, len: i64)
ns_free_bytes :: extern fn(pointer: ^u8, len: i64)

null_of :: fn($T: Type) -> ^T {
    zero := 0
    unsafe { ptr_cast($T, zero) }
}

// Opens a window with the default lit scene. Release it with `close`.
//
// A handle of nothing is what C answers with when the window could not be
// opened. Every later call would read through it and do nothing, so the failure
// is said here rather than as a program that runs and draws no frames.
open :: fn() -> App {
    held := unsafe { ns_open() }
    if (held == null_of($u8)) {
        unsafe { frost_rt_error("nightshade: the engine did not open\n") }
        frost_rt_die()
    }
    held
}

// Advances one frame. False when the engine asks to exit, which is what a main
// loop runs until.
frame :: fn(app: App) -> bool { unsafe { ns_frame(app) } }

close :: fn(app: App) { unsafe { ns_close(app) } }

// A NUL-terminated copy of a string, for the calls below. C reads one until a
// NUL and a `str` has none, so the terminator is added here rather than
// promised by every caller. The wrapper that made it frees it.
c_string :: fn(text: str) -> ^u8 {
    length := str_len(text)
    block := heap_bytes(length + 1)
    mut view := bytes_as($u8, block, length + 1)
    mut index : i64 = 0
    while (index < length) {
        view[index] = text[index]
        index = index + 1
    }
    view[length] = 0
    block
}

// The same for several strings at once: a copy of each, and the array of
// pointers C reads them through.
c_strings :: fn(items: []str) -> CStrings {
    count := slice_len(items)
    mut blocks := heap_slice($^u8, count)
    pointers := heap_array($^i8, count)
    mut index : i64 = 0
    while (index < count) {
        blocks[index] = c_string(items[index])
        unsafe { pointers[index] = ptr_cast($i8, blocks[index]) }
        index = index + 1
    }
    CStrings { pointer = pointers, blocks = blocks, count = count }
}

c_strings_free :: fn(move held: CStrings) {
    mut index : i64 = 0
    while (index < held.count) {
        heap_release($u8, held.blocks[index])
        index = index + 1
    }
    heap_release_slice($^u8, held.blocks)
    heap_release($^i8, held.pointer)
}

// The bytes at a NUL-terminated pointer, counted.
cstr_len :: fn(raw: ^i8) -> i64 {
    mut length : i64 = 0
    while (unsafe { raw[length] } != 0) {
        length = length + 1
    }
    length
}

// Text the engine allocated, as a view of the bytes it owns.
text_from :: fn(raw: ^i8) -> Text {
    if (raw == null_of($i8)) {
        return Text { text = "", pointer = raw }
    }
    Text {
        text = unsafe { slice_from($u8, ptr_cast($u8, raw), cstr_len(raw)) },
        pointer = raw,
    }
}

text_free :: fn(move held: Text) {
    if (held.pointer != null_of($i8)) {
        unsafe { ns_free_string(held.pointer) }
    }
}

entities_from :: fn(pointer: ^Entity, count: i64) -> Entities {
    Entities {
        items = unsafe { slice_from($Entity, pointer, count) },
        pointer = pointer,
        count = count,
    }
}

entities_free :: fn(move held: Entities) {
    unsafe { ns_free_entities(held.pointer, held.count) }
}

bytes_from :: fn(pointer: ^u8, count: i64) -> Bytes {
    Bytes {
        items = unsafe { slice_from($u8, pointer, count) },
        pointer = pointer,
        count = count,
    }
}

bytes_free :: fn(move held: Bytes) {
    unsafe { ns_free_bytes(held.pointer, held.count) }
}

strings_from :: fn(pointer: ^^i8, count: i64) -> Strings {
    Strings { pointer = pointer, count = count }
}

// One of the strings, as a view of the bytes C owns. The index is checked
// against the run's length the way a slice index is, because the run is a raw
// pointer and nothing else here would catch reading past its end. The view
// lasts until the run is freed.
strings_at :: fn(held: Strings, index: i64) -> str {
    frost_rt_bounds_check(index, held.count)
    raw := unsafe { held.pointer[index] }
    unsafe { slice_from($u8, ptr_cast($u8, raw), cstr_len(raw)) }
}

strings_free :: fn(move held: Strings) {
    unsafe { ns_free_strings(held.pointer, held.count) }
}

