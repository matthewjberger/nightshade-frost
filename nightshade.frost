ns_spawn_object :: extern fn(app: App, shape: u32, position_x: f32, position_y: f32, position_z: f32, scale_x: f32, scale_y: f32, scale_z: f32, color_x: f32, color_y: f32, color_z: f32, color_w: f32, value body: Body) -> Entity
