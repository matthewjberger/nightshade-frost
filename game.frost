// Coin hunt: walk the yard and pick up every coin.
//
//   just game
//
// WASD walks, the mouse looks, space jumps, shift sprints. Walk into a coin to
// take it. Escape quits.
//
// The engine calls come from [nightshade.frost](nightshade.frost), which
// [nightshade_bindgen.frost](nightshade_bindgen.frost) generates from the
// engine's command manifest.

import "nightshade.frost"
import "format.frost"
import "vec.frost"

TOTAL :: 12
PICKUP :: 2.56
FLOOR :: 18.0

Coin :: struct {
    entity: Entity,
    x: f32,
    z: f32,
    alive: bool,
}

// Where the coins sit. Written out rather than scattered by a generator, so the
// yard is the same every run.
coin_spot :: fn(index: i64) -> (x: f32, z: f32) {
    if (index == 0) { return 6.0, 4.0 }
    if (index == 1) { return 0.0 - 5.0, 7.0 }
    if (index == 2) { return 9.0, 0.0 - 3.0 }
    if (index == 3) { return 0.0 - 8.0, 0.0 - 6.0 }
    if (index == 4) { return 2.0, 11.0 }
    if (index == 5) { return 12.0, 8.0 }
    if (index == 6) { return 0.0 - 11.0, 2.0 }
    if (index == 7) { return 4.0, 0.0 - 10.0 }
    if (index == 8) { return 0.0 - 3.0, 0.0 - 12.0 }
    if (index == 9) { return 13.0, 0.0 - 11.0 }
    if (index == 10) { return 0.0 - 13.0, 11.0 }
    return 7.0, 14.0
}

// The four pillars, which are there so the yard has corners to walk around and
// something for the light to fall on.
pillar_spot :: fn(index: i64) -> (x: f32, z: f32) {
    if (index == 0) { return 5.0, 5.0 }
    if (index == 1) { return 0.0 - 6.0, 5.0 }
    if (index == 2) { return 5.0, 0.0 - 6.0 }
    return 0.0 - 6.0, 0.0 - 6.0
}

// The line across the top of the screen, rebuilt whenever the count changes.
show_score :: fn(app: App, hud: Entity, taken: i64) {
    mut line := builder_new(64)
    if (taken >= TOTAL) {
        builder_str_value(line, "All ")
        builder_int(line, TOTAL)
        builder_str_value(line, " collected")
    } else {
        builder_str_value(line, "Coins ")
        builder_int(line, taken)
        builder_str_value(line, " / ")
        builder_int(line, TOTAL)
    }
    set_text(app, hud, builder_str(line))
    builder_free(line)
}

build_yard :: fn(app: App) {
    set_background(app, Background {
        tag = BACKGROUND_SUNSET,
        color = [0.0, 0.0, 0.0, 0.0],
        hdr = null_of($u8),
        hdr_len = 0,
    })
    show_grid(app, false)

    ground := spawn_floor(app, FLOOR)
    set_color(app, ground, 0.22, 0.26, 0.2, 1.0)

    mut index : i64 = 0
    while (index < 4) {
        x, z := pillar_spot(index)
        pillar := spawn_object(app, SHAPE_CUBE, x, 1.5, z, 1.0, 3.0, 1.0,
            0.35, 0.33, 0.4, 1.0,
            Body { tag = BODY_STATIC, dynamic_mass = 0.0 })
        set_color(app, pillar, 0.35, 0.33, 0.4, 1.0)
        index = index + 1
    }

    point_light(app, 0.0, 6.0, 0.0, 1.0, 0.85, 0.6, 60.0)
    point_light(app, 0.0 - 10.0, 5.0, 10.0, 0.5, 0.7, 1.0, 40.0)
}

// A coin is a torus, lifted to chest height and lit from inside so it reads
// against the ground from across the yard.
place_coins :: fn(app: App, mut coins: Vec<Coin>) {
    mut index : i64 = 0
    while (index < TOTAL) {
        x, z := coin_spot(index)
        entity := spawn_torus(app, x, 1.1, z)
        set_color(app, entity, 1.0, 0.78, 0.2, 1.0)
        set_emissive(app, entity, 1.0, 0.7, 0.15, 2.5)
        set_scale(app, entity, 0.45, 0.45, 0.45)
        vec_push($Coin, coins, Coin {
            entity = entity,
            x = x,
            z = z,
            alive = true,
        })
        index = index + 1
    }
}

main :: fn() -> i64 {
    app := open()
    set_window_title(app, "Coin Hunt")

    build_yard(app)

    mut coins := vec_new($Coin, TOTAL)
    place_coins(app, coins)

    first_person(app, 0.0, 1.6, 14.0)
    lock_cursor(app, true)

    hud := spawn_text(app, "Coins 0 / 12", SCREEN_ANCHOR_TOP_LEFT)
    set_text_size(app, hud, 34.0)
    set_text_color(app, hud, 1.0, 0.95, 0.8, 1.0)

    hint := spawn_text(app, "WASD to walk, mouse to look, escape to quit",
        SCREEN_ANCHOR_BOTTOM_CENTER)
    set_text_size(app, hint, 20.0)
    set_text_color(app, hint, 0.8, 0.8, 0.85, 1.0)

    mut taken : i64 = 0
    while (frame(app)) {
        step := delta_time(app)
        eye := camera_position(app)

        held := vec_slice($Coin, coins)
        mut index : i64 = 0
        while (index < TOTAL) {
            ref coin := held[index]
            if (coin.alive) {
                rotate(app, coin.entity, 0.0, 1.0, 0.0, step * 1.8)
                dx := eye.x - coin.x
                dz := eye.z - coin.z
                if (dx * dx + dz * dz < PICKUP) {
                    coin.alive = false
                    despawn(app, coin.entity)
                    emit_burst(app, coin.x, 1.1, coin.z,
                        1.0, 0.8, 0.25, 1.0, 48)
                    taken = taken + 1
                    show_score(app, hud, taken)
                }
            }
            index = index + 1
        }

        if (key_pressed(app, "escape")) {
            request_exit(app)
        }
    }

    vec_free($Coin, coins)
    close(app)
    0
}
